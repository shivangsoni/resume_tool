{
  "routes": [
    { "route": "/api/profile*", "allowedRoles": ["authenticated"] },
    { "route": "/api/applications*", "allowedRoles": ["authenticated"] },
    { "route": "/api/resume*", "allowedRoles": ["authenticated"] },
    { "route": "/api/mailbox*", "allowedRoles": ["authenticated"] }
  ],
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/80fa3d36-87ac-489f-890a-6f0b55870bc5/v2.0",
          "clientIdSettingName": "AZURE_CLIENT_ID",
          "clientSecretSettingName": "AZURE_CLIENT_SECRET"
        }
      }
    }
  },
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/assets/*.{css,js,png,jpg,svg}", "/api/*", "/.auth/*"] },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob: https://*.azurewebsites.net"
  }
}
